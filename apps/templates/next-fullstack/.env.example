# The seat writes real values into .env.local when the infra stack starts, and
# the host injects managed equivalents at deploy time. Never commit secrets.
DATABASE_URL=postgresql://byoi:password@127.0.0.1:5432/byoi
REDIS_URL=redis://default:password@127.0.0.1:6379
AUTH_SECRET=generate-me
AUTH_URL=http://127.0.0.1:3000
AUTH_TRUST_HOST=true
