# Copy to deploy/.env. Deploy credentials go in the repo-root .env (or better,
# data/secrets/ via scripts/salon-secrets.sh) — not here.

# Wildcard TLS is issued for *.BYOI_DOMAIN, so a session lands on
# https://s-<session>.BYOI_DOMAIN and the desk on https://BYOI_DOMAIN.
BYOI_DOMAIN=salon.example.com
BYOI_ACME_EMAIL=you@example.com

# DNS-01 needs an API token for the zone. BYOI_DNS_PLUGIN must be the caddy-dns
# module for the same provider — it is compiled into the image.
BYOI_DNS_PROVIDER=cloudflare
BYOI_DNS_PLUGIN=github.com/caddy-dns/cloudflare
BYOI_DNS_API_TOKEN=

BYOI_SALON_NAME=BYOI salon
BYOI_SEAT_IMAGE=byoi-seat:latest
# Every seat is RAM on this VM now, not a PC somebody already owns.
BYOI_MAX_SEATS=4
