# A seat. This is the only container that runs guest code, so it gets none of
# the desk's credentials and — deliberately — no Docker socket and no Docker
# client. Its Postgres and Redis are raised for it by the desk.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssl ca-certificates curl gnupg tmux openssh-client procps \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# A headless browser, reached as an MCP server rather than as a Bash command.
# That is not a matter of taste: Claude Code's Bash safety classifier denies
# anything off the allowlist *before* it emits a control request, so a browser
# driven from Bash could never be approved from the phone (docs/salon.md, "Bash
# approval"). MCP tools take the ordinary permission path, which the seat
# already turns into an Allow / Deny card.
#
# Installed into its own tree rather than globally. @playwright/mcp pins an
# exact, often prerelease, playwright, and chromium build ids are pinned per
# playwright version -- installing the browser with any other copy of the CLI
# lands a revision the server then refuses to launch. `install-browser` is the
# server's own subcommand, so the two can never drift apart.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH=/opt/browser-mcp/node_modules/.bin:$PATH
RUN mkdir -p /opt/browser-mcp \
    && cd /opt/browser-mcp \
    && npm init -y >/dev/null \
    && npm install @playwright/mcp@0.0.80 \
    && apt-get update \
    && ./node_modules/.bin/playwright-mcp install-browser chromium --with-deps \
    && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app
# README.md is not documentation here: pyproject's `readme` field points at
# it, so an editable install without it fails.
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[salon]"
COPY apps ./apps
COPY scripts ./scripts
# Found by claude_chat.seat_mcp_config() at ROOT/deploy/seat-mcp.json, which is
# the same relative path the salon PC uses out of a checkout.
COPY deploy/seat-mcp.json ./deploy/seat-mcp.json

ENV PYTHONPATH=/app:/app/src \
    BYOI_GUEST_TLS=0 \
    BYOI_GUEST_NET=public \
    BYOI_TRANSPORT=wifi \
    BYOI_GUEST_RUNTIME_DIR=/run/byoi

COPY deploy/seat-entrypoint.sh /usr/local/bin/seat-entrypoint
RUN chmod +x /usr/local/bin/seat-entrypoint

EXPOSE 8787 8788
ENTRYPOINT ["/usr/local/bin/seat-entrypoint"]
